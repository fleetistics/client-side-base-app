{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@test-utils": [
        "./src/test/test-utils.tsx"
      ],
      "@server-side-base-url": [
        "./server-side-base-url.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods"
  ]
}